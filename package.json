{
  "name": "copy-manager",
  "version": "0.2.1",
  "private": true,
  "description": "Windows clipboard manager (Electron + TypeScript) — win+v 대체 개인용 도구",
  "author": "user",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
